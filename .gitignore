# Logs and AI Agent data
costs.json
history.json
last_execution.log
*.log
comp.txt
build.log

# Temporary and Analysis Clones
knx_repo/
openknx_repo/
openknx_tpuart/

# Sensitive keys
.deploy_key*
.env

# PlatformIO
.pio/
tul-knx-gateway/.pio/
*.hex

# Python caches
__pycache__/
*.pyc

# Webflasher artefacts must never reach github — neither the HTML/manifest
# templates nor the assembled staging dir. Only scripts/deploy_webflasher.sh
# (the tooling) is versioned.
webflasher/
scripts/webflasher/

# Factory firmware images — build artifacts, regenerated by build_factory.sh
binaries/factory_*.bin

# OS generated files
.DS_Store
Thumbs.db
._*

# Hardware reference material — vendor datasheets are copyrighted, schematics
# are Busware-proprietary, and Eagle CAD generates a lot of backup junk.
# Everything in these dirs stays local to my working tree.
HARDWARE_STATUS.md
datasheets/
schematics/
*.s##
*.s#1
*.sch.bak-*

# Project config
FACTS.md
MEMORY.md
project_config.json
CLAUDE.md
GEMINI.md

# NIEMALS in Git (projekt-übergreifende Regel, 2026-05-19):
# Komplettierung der Liste: .env.*-Varianten, *.key, *.pem.
# (HARDWARE_STATUS.md, datasheets/, schematics/, FACTS.md, MEMORY.md,
#  CLAUDE.md, GEMINI.md, *.log, .env sind oben schon erfasst.)
.env.*
*.key
*.pem
datasheet/
